# Copy to .env.local and fill in. These two values are safe to ship to the browser.
# Supabase dashboard -> Project Settings -> API (or `supabase status` locally).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER put the service_role key in any VITE_ variable or commit it anywhere.

# Only used by the Playwright e2e tests (local `supabase start` stack):
# E2E_BASE_URL=http://localhost:5173
